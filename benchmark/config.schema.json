{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogcode.dev/benchmark/config.schema.json",
  "title": "ogcode benchmark configuration",
  "description": "A complete benchmark definition. The Python loader in benchlib/config.py is authoritative; this schema exists for editor completion and early validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "provider", "model"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional reference to this schema."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Short name recorded in metadata and reports."
    },
    "description": {
      "type": "string",
      "description": "Human-readable note about the model or endpoint."
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ollama-cloud", "openrouter", "anthropic", "openai", "custom"],
          "description": "Provider family. Each family has a built-in base URL and key variable."
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Override the provider's default OpenAI/Anthropic-compatible endpoint. Required for kind=custom."
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Environment variable that holds the API key. Required for kind=custom."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name used for a custom provider."
        },
        "opencode_provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Override the provider id opencode uses. Custom and overridden endpoints get a generated provider block."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "custom"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["base_url", "api_key_env"]
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical model id, exactly as the provider names it."
        },
        "pricing": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/pricing"}
          ],
          "description": "USD per 1M tokens. When null, pricing.json is used."
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ogcode": {"$ref": "#/$defs/agent"},
        "opencode": {"$ref": "#/$defs/agent"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reps": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "Independent repetitions per task and agent."
        },
        "tasks": {
          "oneOf": [
            {"type": "string", "enum": ["all"]},
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          ],
          "default": "all",
          "description": "Task names under tasks/, or 'all'."
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["ogcode", "opencode"]},
          "default": ["ogcode", "opencode"]
        },
        "jobs": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of agent runs executed concurrently."
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "default": 600,
          "description": "Wall-clock limit for one agent run."
        },
        "verify_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "default": 300,
          "description": "Wall-clock limit for one verifier invocation."
        },
        "index_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "default": 900,
          "description": "Wall-clock limit for the pre-run ogcode index build."
        },
        "output_dir": {
          "type": "string",
          "minLength": 1,
          "default": "results",
          "description": "Relative paths are resolved against the benchmark package root."
        }
      }
    }
  },
  "$defs": {
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {"type": "number", "minimum": 0},
        "output": {"type": "number", "minimum": 0},
        "cache_read": {"type": "number", "minimum": 0},
        "cache_write": {"type": "number", "minimum": 0}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Agent-specific model string. Defaults to the canonical id for ogcode and provider/model for opencode."
        },
        "extra_args": {
          "type": "array",
          "items": {"type": "string"},
          "default": [],
          "description": "Extra CLI arguments inserted before the prompt."
        }
      }
    }
  }
}
