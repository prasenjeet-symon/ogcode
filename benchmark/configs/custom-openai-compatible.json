{
  "$schema": "../config.schema.json",
  "name": "custom-openai-compatible",
  "description": "Template for any OpenAI-compatible endpoint. Replace base_url, api_key_env, model.id and pricing before a real run.",
  "provider": {
    "kind": "custom",
    "base_url": "https://your-endpoint.example/v1",
    "api_key_env": "BENCHMARK_API_KEY",
    "name": "Custom OpenAI-compatible endpoint"
  },
  "model": {
    "id": "your-model-id",
    "pricing": null
  },
  "agents": {
    "ogcode": {
      "model": "your-model-id"
    },
    "opencode": {
      "model": "benchmark/your-model-id"
    }
  },
  "run": {
    "reps": 5,
    "tasks": "all",
    "agents": ["ogcode", "opencode"],
    "jobs": 1,
    "timeout_s": 600,
    "verify_timeout_s": 300,
    "index_timeout_s": 900,
    "output_dir": "results/custom-openai-compatible"
  }
}
