---
// Every docs page. The route comes from the content collection; the title,
// description and ordering come from src/lib/nav.ts, so a page is reachable
// only when it is in both (and the nav stays the single source of truth).
import { getCollection, render } from 'astro:content';
import Docs from '../layouts/Docs.astro';
import { groupFor, pageFor } from '../lib/nav';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => {
    const slug = '/' + entry.id.replace(/\/$/, '');
    return {
      params: { slug: entry.id },
      props: { entry, slug, page: pageFor(slug) },
    };
  });
}

const { entry, slug, page } = Astro.props;
const { Content, headings } = await render(entry);

const title = page?.title ?? entry.data.title;
const description = page?.description ?? entry.data.description ?? '';
const canonical = `https://ogcode.in/docs${slug}/`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  inLanguage: 'en',
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'Ogcode Docs', url: 'https://ogcode.in/docs/' },
  publisher: { '@type': 'Organization', name: 'Ogcode', url: 'https://ogcode.in/' },
});

// BreadcrumbList: Docs → group → page. The sidebar group heading is not a
// link, so the middle crumb carries a name but no URL.
const group = groupFor(slug);
const crumbs = [
  { '@type': 'ListItem', position: 1, name: 'Ogcode Docs', item: 'https://ogcode.in/docs/' },
  ...(group ? [{ '@type': 'ListItem', position: 2, name: group.group }] : []),
  { '@type': 'ListItem', position: group ? 3 : 2, name: title, item: canonical },
];
const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs,
});
---
<Docs title={title} description={description} slug={slug} headings={headings}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
    <script type="application/ld+json" set:html={breadcrumbLd} />
  </Fragment>
  <Content />
</Docs>
