---
// Dark/light switch. The glyph swap is pure CSS (docs.css): the sun shows in
// the dark theme, the moon in the light. The click handler here owns the
// localStorage key and the <html data-theme> attribute; Base.astro reads the
// same key before first paint to avoid a flash.
---
<button id="theme-toggle" class="nav-link theme-toggle" type="button" aria-label="Toggle colour theme" title="Toggle colour theme">
  <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button>

<script>
  // Pin the opposite of whatever is showing: data-theme when the reader has
  // chosen one, otherwise the OS preference the CSS is already following.
  const toggle = document.getElementById('theme-toggle');
  if (toggle) {
    const KEY = 'ogcode-docs-theme';
    const root = document.documentElement;
    const current = () =>
      root.getAttribute('data-theme') ??
      (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    toggle.addEventListener('click', () => {
      const next = current() === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem(KEY, next);
      } catch {}
    });
  }
</script>
