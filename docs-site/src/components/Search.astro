---
// Pagefind search, in the sidebar.
//
// The index and the UI bundle are built after Astro, by postbuild.mjs, into
// /docs/pagefind/. Nothing is available in `astro dev` (the index does not
// exist yet), so the box mounts lazily and stays quiet if the bundle is
// missing — a 404 on the script leaves an empty, harmless box.
---
<div class="ds-search" data-pagefind-ignore>
  <div id="search" aria-label="Search the docs"></div>
</div>

<script>
  const mount = document.getElementById('search');
  if (mount) {
    const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/docs'
    const ui = document.createElement('script');
    ui.src = `${base}/pagefind/pagefind-ui.js`;
    ui.onload = () => {
      const PagefindUI = (window as any).PagefindUI;
      if (!PagefindUI) return;
      new PagefindUI({
        element: '#search',
        bundlePath: `${base}/pagefind/`,
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: {
          placeholder: 'Search the docs',
          zero_results: 'No results for [SEARCH_TERM]',
        },
      });
    };
    document.head.appendChild(ui);
  }
</script>
