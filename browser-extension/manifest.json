{
  "manifest_version": 3,
  "name": "ogweb",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Drive your Chrome tabs from ogcode over a local WebSocket bridge, limited to tabs you explicitly allow.",
  "permissions": ["debugger", "tabs", "sidePanel", "storage", "nativeMessaging", "alarms"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "ogweb",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}