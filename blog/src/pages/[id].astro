---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AuthorCard from '../components/AuthorCard.astro';
import CtaSlab from '../components/CtaSlab.astro';
import { publishedPosts, formatDate, type Post } from '../lib/posts';
import { AUTHOR } from '../lib/author';
import '../styles/post.css';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

const canonical = `https://ogcode.in/blog/${post.id}/`;
const readingTime = remarkPluginFrontmatter.readingTime as number;
const byDefaultAuthor = post.data.author === AUTHOR.name;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Ogcode', url: 'https://ogcode.in/' },
  mainEntityOfPage: canonical,
  image: post.data.ogImage,
});
---
<Base
  title={`${post.data.title} — Ogcode Blog`}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  ogImage={post.data.ogImage}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    {post.data.updatedDate && (
      <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />
    )}
    <meta property="article:author" content={post.data.author} />
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <article class="bp" aria-labelledby="bp-title">
    <header class="bp-head frame">
      <div class="bp-head-in rise">
        <a class="btn btn-line btn-sm bp-back" href="/blog/">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg>
          All posts
        </a>

        <p class="meta-row bp-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span class="sep" aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
          {post.data.draft && <span class="chip chip-draft">DRAFT</span>}
        </p>

        <h1 class="bp-title" id="bp-title">{post.data.title}</h1>
        <p class="bp-lede">{post.data.description}</p>

        <div class="bp-credits">
          <div class="bp-byline">
            {byDefaultAuthor ? (
              <img class="bp-avatar" src={AUTHOR.avatar} alt="" width="30" height="30" />
            ) : (
              <span class="bp-avatar bp-avatar-initial" aria-hidden="true">{post.data.author.charAt(0)}</span>
            )}
            <div class="bp-byline-text">
              <span class="bp-byline-name">{post.data.author}</span>
              <span class="bp-byline-role">Building Ogcode</span>
            </div>
          </div>
          {post.data.tags.length > 0 && (
            <ul class="bp-tags" aria-label="Tags">
              {post.data.tags.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
          )}
        </div>
      </div>
    </header>

    {post.data.hero ? (
      <div class="frame">
        <figure class="box bp-hero">
          <span class="cn tl" aria-hidden="true"></span>
          <span class="cn tr" aria-hidden="true"></span>
          <span class="cn bl" aria-hidden="true"></span>
          <span class="cn br" aria-hidden="true"></span>
          <img
            src={post.data.hero}
            alt={post.data.heroAlt ?? ''}
            width="1344"
            height="768"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    ) : (
      <div class="frame bp-rule" aria-hidden="true">
        <span class="cn tl"></span>
        <span class="cn tr"></span>
      </div>
    )}

    <div class="bp-body frame">
      <div class="bp-prose">
        <Content />
      </div>

      {byDefaultAuthor && <AuthorCard />}

      <nav class="bp-foot" aria-label="More from the blog">
        <a class="btn btn-line btn-sm bp-back" href="/blog/">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg>
          All posts
        </a>
        <a class="bp-rss" href="/blog/rss.xml">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          Subscribe via RSS
        </a>
      </nav>
    </div>
  </article>

  <CtaSlab />
</Base>
