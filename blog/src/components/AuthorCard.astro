---
// Follow-the-author card shown at the end of every post by the default
// author: a blueprint box (corner squares) with the follow links as pills.
// Styles live in post.css; importing it here keeps the card self-contained
// (Astro dedupes the stylesheet when the page imports it too).
import { AUTHOR } from '../lib/author';
import '../styles/post.css';
---
<aside class="box bp-author" aria-label="About the author">
  <span class="cn tl" aria-hidden="true"></span>
  <span class="cn tr" aria-hidden="true"></span>
  <span class="cn bl" aria-hidden="true"></span>
  <span class="cn br" aria-hidden="true"></span>

  <img
    class="bp-author-avatar"
    src={AUTHOR.avatar}
    alt=""
    width="56"
    height="56"
    loading="lazy"
    decoding="async"
  />
  <div class="bp-author-body">
    <p class="bp-author-kicker">Written by</p>
    <p class="bp-author-name">{AUTHOR.name}</p>
    <p class="bp-author-role">{AUTHOR.role}, in the open. If this post was useful, following is the best way to catch the next one.</p>
    <ul class="bp-author-links" aria-label={`Follow ${AUTHOR.name}`}>
      {AUTHOR.links.map((link) => (
        <li>
          <a class="btn btn-line btn-sm" href={link.url} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={link.icon} /></svg>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>
