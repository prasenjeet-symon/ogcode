---
// The homepage footer (docs/index.html), link for link. Homepage
// anchors become absolute (/#recall …), Install lands on /#install
// (the homepage opens its install panel from that hash), and the Docs
// column gains the blog's RSS feed. No "Pause animations" control:
// the blog runs no looping animation to pause.
const REPO = 'https://github.com/prasenjeet-symon/ogcode';
const DISCORD = 'https://discord.gg/JQP9t8y2Zv';
const year = new Date().getFullYear();

const githubPath = 'M12 .5A11.5 11.5 0 00.5 12a11.5 11.5 0 007.86 10.94c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.3-5.24-1.28-5.24-5.67 0-1.25.45-2.27 1.18-3.07-.12-.3-.51-1.46.11-3.05 0 0 .96-.3 3.15 1.17a10.9 10.9 0 015.74 0c2.19-1.47 3.15-1.17 3.15-1.17.62 1.59.23 2.75.11 3.05.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.37-5.25 5.66.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12 11.5 11.5 0 0012 .5z';
const discordPath = 'M20.3 4.4A19.8 19.8 0 0015.4 3l-.3.5c1.5.4 2.7.9 4 1.7a13.6 13.6 0 00-11.9 0c1.2-.8 2.6-1.3 4-1.7L10.6 3a19.8 19.8 0 00-4.9 1.4C2.5 9.1 1.7 13.7 2.1 18.3a20 20 0 006 3l.5-.7c-1-.4-2-1-2.8-1.6l.7-.5a14.2 14.2 0 0012.7 0l.7.5c-.9.6-1.8 1.2-2.8 1.6l.5.7a20 20 0 006-3c.5-5.3-.8-9.9-3.3-14zM8.5 15c-.9 0-1.7-.9-1.7-2s.7-2 1.7-2 1.7.9 1.7 2-.8 2-1.7 2zm7 0c-.9 0-1.7-.9-1.7-2s.7-2 1.7-2 1.7.9 1.7 2-.8 2-1.7 2z';

type Link = { label: string; href: string };
const ext = (href: string) => /^https?:/.test(href);

const columns: { title: string; links: Link[] }[] = [
  {
    title: 'Product',
    links: [
      { label: 'Recall', href: '/#recall' },
      { label: 'Models', href: '/#models' },
      { label: 'Cost', href: '/#cost' },
      { label: 'OGX plan', href: '/ogx/' },
      { label: 'Context engine', href: '/#product' },
      { label: 'Code review', href: '/#review' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { label: 'Blog', href: '/blog/' },
      { label: 'RSS feed', href: '/blog/rss.xml' },
      { label: 'README', href: `${REPO}#readme` },
      { label: 'Quick start', href: `${REPO}#quick-start` },
      { label: 'Configuration', href: `${REPO}#configuration` },
      { label: 'Remote deployment', href: `${REPO}#remote-deployment-and-security` },
      { label: 'Changelog', href: `${REPO}/releases` },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'GitHub', href: REPO },
      { label: 'Discord', href: DISCORD },
      { label: 'Report an issue', href: `${REPO}/issues` },
      { label: 'License', href: `${REPO}/blob/main/LICENSING.md` },
    ],
  },
  {
    title: 'Get started',
    links: [
      { label: 'Install Ogcode', href: '/#install' },
      { label: 'All releases', href: `${REPO}/releases/latest` },
      { label: 'Docker image', href: `${REPO}/pkgs/container/ogcode` },
      { label: 'FAQ', href: '/#faq' },
    ],
  },
];

const legal: Link[] = [
  { label: 'Blog', href: '/blog/' },
  { label: 'GitHub', href: REPO },
  { label: 'Discord', href: DISCORD },
  { label: 'License', href: `${REPO}/blob/main/LICENSING.md` },
];
---
<footer class="footer">
  <div class="frame">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Ogcode home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none"><path d="M54 32A22 22 0 0 0 32 10A22 22 0 0 0 10 32A22 22 0 0 0 32 54A13 13 0 0 0 43 33" stroke="#fff" stroke-width="8" stroke-linecap="round"/></svg>
          </span>
          <span class="brand-name">ogcode</span>
        </a>
        <p class="footer-tag">The coding agent that remembers. Self-hosted, open source, yours.</p>
        <div class="footer-social">
          <a class="btn btn-line icon-btn" href={REPO} target="_blank" rel="noopener" aria-label="Ogcode on GitHub"><svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={githubPath}/></svg></a>
          <a class="btn btn-line icon-btn" href={DISCORD} target="_blank" rel="noopener" aria-label="Ogcode on Discord"><svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={discordPath}/></svg></a>
        </div>
      </div>

      {columns.map((col) => (
        <div class="footer-col">
          <h2 class="footer-h">{col.title}</h2>
          <ul role="list">
            {col.links.map((l) => (
              <li>
                {ext(l.href)
                  ? <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
                  : <a href={l.href}>{l.label}</a>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <span>© {year} Ogcode · AGPL-3.0 · one binary, self-hosted</span>
      <nav class="footer-legal" aria-label="Legal and social">
        {legal.map((l, i) => (
          <Fragment>
            {i > 0 && <span class="sep" aria-hidden="true">|</span>}
            {ext(l.href)
              ? <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
              : <a href={l.href}>{l.label}</a>}
          </Fragment>
        ))}
      </nav>
    </div>
  </div>
</footer>
