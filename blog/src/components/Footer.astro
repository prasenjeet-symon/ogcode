---
// Mirrors the homepage footer, with the blog's own links added.
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Ogcode home">
          <span class="brand-mark">
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d="M54 32A22 22 0 0 0 32 10A22 22 0 0 0 10 32A22 22 0 0 0 32 54A13 13 0 0 0 43 33"
                    stroke="#fff" stroke-width="8" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="brand-name">ogcode</span>
        </a>
        <p>The coding agent that remembers. Self-hosted, open source, yours.</p>
      </div>

      <div>
        <h5>Product</h5>
        <ul>
          <li><a href="/#scenes">Product tour</a></li>
          <li><a href="/#context">Context engine</a></li>
          <li><a href="/#speed">Speed</a></li>
        </ul>
      </div>

      <div>
        <h5>Blog</h5>
        <ul>
          <li><a href="/blog/">All posts</a></li>
          <li><a href="/blog/rss.xml">RSS feed</a></li>
          <li><a href="https://github.com/prasenjeet-symon/ogcode/releases" target="_blank" rel="noopener">Changelog</a></li>
          <li><a href="https://github.com/prasenjeet-symon/ogcode#readme" target="_blank" rel="noopener">README</a></li>
        </ul>
      </div>

      <div>
        <h5>Community</h5>
        <ul>
          <li><a href="https://github.com/prasenjeet-symon/ogcode" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://discord.gg/JQP9t8y2Zv" target="_blank" rel="noopener">Discord</a></li>
          <li><a href="https://github.com/prasenjeet-symon/ogcode/issues" target="_blank" rel="noopener">Report an issue</a></li>
          <li><a href="https://github.com/prasenjeet-symon/ogcode/blob/main/LICENSING.md" target="_blank" rel="noopener">License</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Ogcode · AGPL-3.0 · One binary, self-hosted</span>
      <div class="footer-social">
        <a href="https://github.com/prasenjeet-symon/ogcode" target="_blank" rel="noopener" aria-label="GitHub">
          <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 00.5 12a11.5 11.5 0 007.86 10.94c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.3-5.24-1.28-5.24-5.67 0-1.25.45-2.27 1.18-3.07-.12-.3-.51-1.46.11-3.05 0 0 .96-.3 3.15 1.17a10.9 10.9 0 015.74 0c2.19-1.47 3.15-1.17 3.15-1.17.62 1.59.23 2.75.11 3.05.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.37-5.25 5.66.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12 11.5 11.5 0 0012 .5z"/></svg>
        </a>
        <a href="https://discord.gg/JQP9t8y2Zv" target="_blank" rel="noopener" aria-label="Discord">
          <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 4.4A19.8 19.8 0 0015.4 3l-.3.5c1.5.4 2.7.9 4 1.7a13.6 13.6 0 00-11.9 0c1.2-.8 2.6-1.3 4-1.7L10.6 3a19.8 19.8 0 00-4.9 1.4C2.5 9.1 1.7 13.7 2.1 18.3a20 20 0 006 3l.5-.7c-1-.4-2-1-2.8-1.6l.7-.5a14.2 14.2 0 0012.7 0l.7.5c-.9.6-1.8 1.2-2.8 1.6l.5.7a20 20 0 006-3c.5-5.3-.8-9.9-3.3-14zM8.5 15c-.9 0-1.7-.9-1.7-2s.7-2 1.7-2 1.7.9 1.7 2-.8 2-1.7 2zm7 0c-.9 0-1.7-.9-1.7-2s.7-2 1.7-2 1.7.9 1.7 2-.8 2-1.7 2z"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="ghost" aria-hidden="true">ogcode</div>
</footer>
